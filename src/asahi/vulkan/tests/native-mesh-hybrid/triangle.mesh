#version 460
#extension GL_EXT_mesh_shader : require
#ifndef VERTICES
#define VERTICES 3
#define PRIMITIVES 1
#define COLOR vec4(0, 0, 1, 1)
#endif
layout(local_size_x=1) in;
layout(triangles, max_vertices=VERTICES, max_primitives=PRIMITIVES) out;
layout(location=0) perprimitiveEXT out vec4 color[];
void main() {
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[0].gl_Position = vec4(-1, -1, 0, 1);
    gl_MeshVerticesEXT[1].gl_Position = vec4(3, -1, 0, 1);
    gl_MeshVerticesEXT[2].gl_Position = vec4(-1, 3, 0, 1);
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    color[0] = COLOR;
}
