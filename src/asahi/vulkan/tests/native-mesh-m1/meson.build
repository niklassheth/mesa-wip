project('native-mesh-m1-probe', 'c', default_options : ['buildtype=release', 'c_std=gnu11', 'warning_level=2'])
cc=meson.get_compiler('c')
vk=cc.find_library('vulkan')
headers=include_directories('../../../../../include')
executable('mesh-m1', 'probe.c', include_directories : headers, dependencies : vk)
shared_library('vm-audit', '../native-stage-batching/vm-audit.c', name_prefix : '', include_directories : headers)
