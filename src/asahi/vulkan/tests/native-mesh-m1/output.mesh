#version 460
#extension GL_EXT_mesh_shader : require
#ifndef MAX_PRIMITIVES
#define MAX_PRIMITIVES 16
#endif
layout(local_size_x=16) in;
layout(triangles,max_vertices=16,max_primitives=MAX_PRIMITIVES) out;
layout(push_constant) uniform Counts { uint vertices; uint primitives; uint cookie; } pc;
layout(set=0,binding=0,std430) buffer Witness { uint q[]; } witness;

vec4 position(uint i) {
    uint tile=i/3;
    uint corner=i%3;
    vec2 origin=vec2(8+32*(tile%3),8+32*(tile/3));
    vec2 pixel=origin+vec2(corner==1 ? 16 : 0,corner==2 ? 15 : 0);
    if(i==15) pixel=vec2(56,55);
    return vec4(pixel.x/64.0-1.0,pixel.y/32.0-1.0,0.5,1.0);
}

void main() {
    uint lane=gl_LocalInvocationIndex;
    SetMeshOutputsEXT(pc.vertices,pc.primitives);
    witness.q[512+lane]=pc.cookie+0x1000+lane;
    if(lane==0) {
        witness.q[4]=pc.vertices;
        witness.q[5]=pc.primitives;
        witness.q[6]=pc.cookie;
    }
    if(lane<pc.vertices) {
        vec4 p=position(lane);
        gl_MeshVerticesEXT[lane].gl_Position=p;
        for(uint c=0;c<4;c++) witness.q[16+4*lane+c]=floatBitsToUint(p[c]);
    }
    for(uint i=lane;i<pc.primitives;i+=16) {
        uint t=i%(pc.vertices==16 ? 6 : 5);
        uvec3 indices=t==5 ? uvec3(13,15,14) : uvec3(3*t,3*t+1,3*t+2);
        gl_PrimitiveTriangleIndicesEXT[i]=indices;
        for(uint c=0;c<3;c++) witness.q[128+3*i+c]=indices[c];
    }
}
