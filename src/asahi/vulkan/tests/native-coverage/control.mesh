#version 460
#extension GL_EXT_mesh_shader : require
#ifndef THREADS
#define THREADS 16
#endif
layout(local_size_x=THREADS) in;
layout(triangles,max_vertices=3,max_primitives=1) out;
void main() {
  SetMeshOutputsEXT(3,1);
  uint i=gl_LocalInvocationIndex;
  if(i<3) gl_MeshVerticesEXT[i].gl_Position=vec4(i==1 ? 0.5 : -0.5,i==2 ? 0.5 : -0.5,0.5,1);
  if(i==0) gl_PrimitiveTriangleIndicesEXT[0]=uvec3(0,1,2);
}
